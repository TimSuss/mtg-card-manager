# Copy to .env.prices on the Pi; this example contains no credentials.
# Used by systemd's EnvironmentFile. Shell users must export these variables.
MTG_SMTP_HOST=smtp.example.com
MTG_SMTP_PORT=587
MTG_SMTP_TLS=starttls
MTG_SMTP_USER=your-smtp-user
MTG_SMTP_PASSWORD=your-app-password
MTG_SMTP_FROM=you@example.com
MTG_SMTP_TO=you@example.com
# For implicit TLS instead: MTG_SMTP_TLS=ssl and MTG_SMTP_PORT=465.
